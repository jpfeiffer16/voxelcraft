#include "resource.h"

VERSION ID 1 "1.0.1"
APPLICATIONICONNAME ID 1000 "VoxelCraft"

ICONFAMILYEX
BEGIN
  BITMAP "../../res/icon_large.bmp" BPP 8 TRANSPARENT 255 255 255
  BITMAP "../../res/icon_large_hd.bmp" BPP 16 DENSITY 2 TRANSPARENT 255 255 255
END

SMALLICONFAMILYEX
BEGIN
  BITMAP "../../res/icon_small.bmp" BPP 8 TRANSPARENT 255 255 255
  BITMAP "../../res/icon_small_hd.bmp" BPP 16 DENSITY 2 TRANSPARENT 255 255 255
END

FORM ID FormMain AT (0 0 160 160)
NOFRAME
BEGIN
END

ALERT ID AlertNeedARM
ERROR
BEGIN
  TITLE "VoxelCraft"
  MESSAGE "VoxelCraft needs an ARM handheld (Palm Tungsten E2 or similar) running Palm OS 5."
  BUTTONS "OK"
END

ALERT ID AlertNeedHiRes
ERROR
BEGIN
  TITLE "VoxelCraft"
  MESSAGE "VoxelCraft needs a 320x320 high-density colour screen."
  BUTTONS "OK"
END

ALERT ID AlertNoMem
ERROR
BEGIN
  TITLE "VoxelCraft"
  MESSAGE "Not enough memory to start VoxelCraft. Need about ^1 KB free (largest free chunk now ^2 KB). Close other apps, do a soft reset, and try again."
  BUTTONS "OK"
END

ALERT ID AlertNeedOS
ERROR
BEGIN
  TITLE "VoxelCraft"
  MESSAGE "VoxelCraft needs Palm OS 5.0 or later (the Tungsten E2 runs 5.4)."
  BUTTONS "OK"
END

ALERT ID AlertLastStage
INFORMATION
BEGIN
  TITLE "VoxelCraft"
  MESSAGE "The last launch stopped during: ^1. This launch will try again. If it fails at the same place, please report that stage."
  BUTTONS "OK"
END
